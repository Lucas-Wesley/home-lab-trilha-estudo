#!/bin/sh
# yt-dlp falso para os vídeos embutidos dos cursos (T55): -J devolve as informações; sem -J, finge
# baixar (progresso do vídeo e do áudio) e grava um "mp4" no -o com %(ext)s = mp4.
for url; do :; done
case "$url" in
  *falha*) echo "ERROR: [vimeo] 1: This video is private" >&2; exit 1 ;;
esac
json=0 out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -J) json=1; shift ;;
    -o) out="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [ $json = 1 ]; then
  printf '{"id":"x","duration":125.4,"height":1080,"requested_formats":[{"filesize":1000,"height":1080},{"filesize_approx":200}]}\n'
  exit 0
fi
echo "[download]  10.0% of 1KiB"
echo "[download] 100.0% of 1KiB"
echo "[download]   5.0% of 1KiB"
echo "[download] 100.0% of 1KiB"
arquivo=$(printf '%s' "$out" | sed 's/%(ext)s/mp4/')
printf 'video embutido' > "$arquivo"
exit 0
